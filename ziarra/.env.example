# Copy to .env.local — never commit real values

# Database (PostgreSQL via Supabase / Neon / Railway)
DATABASE_URL="postgresql://user:password@host:5432/ziarra"

# Auth
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# M-Pesa (Safaricom Daraja API)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://yourdomain.com/api/webhooks/mpesa"

# Cloudinary (marketing assets / package images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="noreply@ziarra.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMMISSION_PCT="8"
